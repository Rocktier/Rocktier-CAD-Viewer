# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust build artifacts
/target
src-tauri/target
src-tauri/Cargo.lock

# Temp files produced by dwg2dxf conversion (never commit)
rcv_dwg_*.dxf

# Provisioned LibreDWG sidecar for the Windows bundle — binaries only, the
# directory itself is tracked (via .gitkeep) so macOS builds keep working.
# See scripts/provision-libredwg-windows.ps1
src-tauri/resources/libredwg/*
!src-tauri/resources/libredwg/.gitkeep

# Real drawings used for local regression — customer files, never commit
testdata/real/*.dwg
testdata/real/*.dxf

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
HANDOFF.md

# CatPaw session context
.zcode/
